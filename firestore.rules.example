// =============================================================================
// قواعد Firestore المقترحة لميزة "الإحصائيات الخاصة بالمالك"
// =============================================================================
//
// هذه قواعد مقترحة - أضفها إلى firestore.rules الحالي.
// لا تستبدل الملف بالكامل! ادمج هذه القواعد بحذر مع قواعدك الحالية.
//
// الفلسفة: الـ UI يخفي البيانات الخاصة عن غير المالك (defense in depth)،
// لكن الحماية الفعلية تكون على مستوى Firestore.
// =============================================================================

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------------
    // listings - قواعد القراءة الحالية تبقى كما هي
    // (الجميع يستطيع قراءة approved listings)
    // ---------------------------------------------------------------------
    match /listings/{listingId} {

      // قواعدك الحالية للقراءة/الكتابة...

      // -----------------------------------------------------------------
      // listings/{id}/events - subcollection لتسجيل النقرات
      //
      // - الجميع يستطيع إنشاء event (لتسجيل النقرة).
      // - المالك فقط يستطيع قراءة الـ events لحساب الإحصائيات.
      // - لا أحد يستطيع التعديل أو الحذف (immutable).
      // -----------------------------------------------------------------
      match /events/{eventId} {

        // المالك فقط يستطيع القراءة
        allow read: if request.auth != null
          && get(/databases/$(database)/documents/listings/$(listingId)).data.ownerId == request.auth.uid;

        // الجميع يستطيع إنشاء event (مع التحقق من النوع)
        allow create: if request.resource.data.type in [
          'view', 'chat_click', 'phone_click', 'whatsapp_click'
        ];

        // لا تعديل، لا حذف
        allow update, delete: if false;
      }
    }

    // ---------------------------------------------------------------------
    // favorites - قاعدة موجودة من قبل
    //
    // ملاحظة مهمة: لتمكين useOwnerStats من حساب favoritesCount عبر
    // collectionGroup('favorites'), أضف فهرساً مركّباً في Firebase Console:
    //
    //   Collection group: favorites
    //   Field: listingId (Ascending)
    //   Field: __name__ (Ascending)
    //
    // وأضف هذه القاعدة:
    // ---------------------------------------------------------------------
    match /{path=**}/favorites/{favoriteId} {
      // كل مستخدم مسجَّل يستطيع تشغيل count على collectionGroup
      // لكن لا يستطيع قراءة بيانات المفضلين الفعلية.
      // (count فقط لا يكشف بيانات شخصية)
      allow list: if request.auth != null;

      // قواعد get/write الحالية تبقى كما هي
    }
  }
}
