// =============================================================================
// قواعد Firestore المقترحة لميزة Stories
// =============================================================================
//
// مهم جداً: هذه القواعد تحمي خصوصية المشاهدات.
// ادمج هذه القواعد مع firestore.rules الحالي.
// =============================================================================

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------------
    // stories - القصص الرئيسية
    //
    // - الجميع يستطيع القراءة (لعرض القصص لأي زائر).
    // - فقط المالك ينشئ بـ ownerId == uid.
    // - viewsCount يُحدَّث عبر increment من قبل أي مستخدم مسجَّل
    //   (لتسجيل المشاهدة) - لكن لا يستطيع تغيير الحقول الأخرى.
    // - فقط المالك يحذف.
    // ---------------------------------------------------------------------
    match /stories/{storyId} {

      // قراءة عامة - الجميع يشاهد
      allow read: if true;

      // إنشاء: المستخدم المسجَّل يكتب قصته فقط
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.type in ['car', 'service', 'offer']
        && request.resource.data.imageUrl is string
        && request.resource.data.imageUrl.size() > 0;

      // تحديث: نسمح فقط بزيادة viewsCount (للمستخدمين المسجَّلين غير المالك)
      // أو السماح للمالك بتعديل قصته.
      allow update: if request.auth != null && (
        // المالك يعدّل
        resource.data.ownerId == request.auth.uid
        ||
        // مشاهد يزيد العدد فقط - باقي الحقول لم تتغير
        (
          request.resource.data.viewsCount == resource.data.viewsCount + 1
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewsCount'])
        )
      );

      // حذف: المالك فقط
      allow delete: if request.auth != null
        && resource.data.ownerId == request.auth.uid;

      // -----------------------------------------------------------------
      // stories/{id}/viewers - قائمة المشاهدين (خصوصية!)
      //
      // - المالك فقط يقرأ القائمة كاملة.
      // - أي مستخدم مسجَّل يكتب سجل مشاهدته (مرة واحدة).
      // -----------------------------------------------------------------
      match /viewers/{viewerId} {

        // قراءة محصورة بمالك القصة
        allow read: if request.auth != null
          && get(/databases/$(database)/documents/stories/$(storyId)).data.ownerId == request.auth.uid;

        // كل مستخدم يكتب سجل مشاهدته فقط
        allow write: if request.auth != null
          && request.auth.uid == viewerId;
      }
    }
  }
}

// =============================================================================
// فهرس مطلوب
// =============================================================================
// أنشئ هذا الفهرس في Firebase Console → Firestore → Indexes:
//
//   Collection: stories
//   Fields:
//     - expiresAt (Ascending)
//
// هذا يدعم استعلام useStories: where('expiresAt', '>', now) order by expiresAt
// =============================================================================

