rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isMe(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() {
      return signedIn() && (
        request.auth.token.admin == true ||
        request.auth.token.email in ['admin@example.com']
      );
    }

    match /users/{userId} {
      allow read: if true;
      allow create: if isMe(userId);
      allow update: if isMe(userId) || isAdmin();
      allow delete: if isAdmin();

      match /favorites/{listingId} {
        allow read: if isMe(userId) || isAdmin();
        allow create, update: if isMe(userId);
        allow delete: if isMe(userId);
      }
    }

    match /listings/{listingId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if (signedIn() && resource.data.ownerId == request.auth.uid) || isAdmin();
      allow delete: if (signedIn() && resource.data.ownerId == request.auth.uid) || isAdmin();

      match /comments/{commentId} {
        allow read: if true;
        allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
        allow delete: if signedIn() && (
          resource.data.userId == request.auth.uid ||
          get(/databases/$(database)/documents/listings/$(listingId)).data.ownerId == request.auth.uid ||
          isAdmin()
        );
        allow update: if false;
      }
    }

    match /stories/{storyId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.media.size() > 0;

      allow update: if (
          signedIn() && resource.data.ownerId == request.auth.uid
        ) || isAdmin() || (
          signedIn()
          && request.writeFields.hasOnly(['viewsCount'])
          && request.resource.data.viewsCount == resource.data.viewsCount + 1
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.type == resource.data.type
          && request.resource.data.coverUrl == resource.data.coverUrl
        );

      allow delete: if (signedIn() && resource.data.ownerId == request.auth.uid) || isAdmin();

      match /viewers/{viewerId} {
        allow read: if signedIn() && (
          request.auth.uid == viewerId ||
          get(/databases/$(database)/documents/stories/$(storyId)).data.ownerId == request.auth.uid ||
          isAdmin()
        );
        allow create: if isMe(viewerId)
          && request.resource.data.userId == request.auth.uid;
        allow update, delete: if false;
      }
    }

    match /chats/{chatId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participants;
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.size() == 2;
      allow update: if signedIn() && request.auth.uid in resource.data.participants;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow create: if signedIn()
          && request.resource.data.senderId == request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow update, delete: if false;
      }
    }

    match /notifications/{notificationId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn();
      allow update: if signedIn() && resource.data.userId == request.auth.uid;
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }
  }
}
