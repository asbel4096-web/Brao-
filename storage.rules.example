// =============================================================================
// قواعد Firebase Storage لميزة Stories
// =============================================================================
// أضف هذا في storage.rules:
// =============================================================================

rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // -----------------------------------------------------------------
    // stories/{userId}/...  - صور القصص
    //
    // - الجميع يستطيع القراءة (لعرض الصور).
    // - المستخدم يستطيع رفع صور تحت مساره فقط.
    // - حد أقصى 5 ميجابايت + content-type صورة فقط.
    // -----------------------------------------------------------------
    match /stories/{userId}/{fileName=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
