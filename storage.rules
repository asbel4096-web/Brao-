rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isImage() {
      return request.resource.contentType.matches('image/(jpeg|jpg|png|webp)([;].*)?');
    }

    function isVideo() {
      return request.resource.contentType.matches('video/(mp4|webm|quicktime)([;].*)?');
    }

    function isAudio() {
      return request.resource.contentType.matches('audio/(mpeg|mp3|wav|webm|ogg|mp4|x-m4a|aac)([;].*)?');
    }

    function imageUnder(bytes) {
      return isImage() && request.resource.size < bytes;
    }

    function videoUnder(bytes) {
      return isVideo() && request.resource.size < bytes;
    }

    function audioUnder(bytes) {
      return isAudio() && request.resource.size < bytes;
    }

    match /stories/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isOwner(userId)
        && (
          imageUnder(8 * 1024 * 1024)
          || videoUnder(25 * 1024 * 1024)
        );
    }

    match /listing-images/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isOwner(userId)
        && imageUnder(10 * 1024 * 1024);
    }

    match /users/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isOwner(userId)
        && imageUnder(5 * 1024 * 1024);
    }

    match /chat-media/{chatId}/{userId}/{allPaths=**} {
      allow read: if signedIn();
      allow write: if isOwner(userId)
        && (
          imageUnder(10 * 1024 * 1024)
          || videoUnder(25 * 1024 * 1024)
          || audioUnder(12 * 1024 * 1024)
        );
    }

    // شعارات الماركات - الكل يقرأ (لتظهر في الصفحة الرئيسية للضيوف).
    // الرفع متاح لأي مستخدم مسجَّل تقنياً، لكن Firestore تمنع غير الأدمن
    // من ربط الرابط بـbrandLogos/{brandId} - وبالتالي الشعار لن يظهر.
    // النتيجة: ملفات يتيمة محتملة لو حاول مستخدم غير أدمن، نُنظّفها يدوياً.
    match /brand-logos/{file} {
      allow read: if true;
      allow write: if signedIn() && imageUnder(2 * 1024 * 1024);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
