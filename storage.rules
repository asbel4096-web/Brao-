rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function maxSize(bytes) { return request.resource.size < bytes; }
    function isImage() { return request.resource.contentType.matches('image/.*'); }
    function isVideo() { return request.resource.contentType.matches('video/.*'); }

    match /listing-images/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if signedIn()
        && request.auth.uid == userId
        && isImage()
        && maxSize(10 * 1024 * 1024);
    }

    match /users/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if signedIn()
        && request.auth.uid == userId
        && isImage()
        && maxSize(5 * 1024 * 1024);
    }

    match /stories/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if signedIn()
        && request.auth.uid == userId
        && (isImage() || isVideo())
        && maxSize(25 * 1024 * 1024);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
