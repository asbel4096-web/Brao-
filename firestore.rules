rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isMe(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // ------------------------------------------------------------------
    // Bootstrap Admin allowlist.
    // Must mirror NEXT_PUBLIC_ADMIN_EMAILS used by the client for the
    // first-login bootstrap in contexts/AuthContext.tsx.
    // Keep this list in sync on every deploy. It is ONLY consulted at
    // user-document creation time; ongoing admin management still goes
    // through the isAdmin field and the /admin/users page.
    // ------------------------------------------------------------------
    function bootstrapAdminEmails() {
      return [
        // 'owner@example.com'
      ];
    }

    function isBootstrapAdminCreate() {
      return signedIn()
        && request.resource.data.email is string
        && request.resource.data.email.lower() in bootstrapAdminEmails();
    }

    function unchanged(keys) {
      return request.resource.data.diff(resource.data).unchangedKeys().hasAll(keys);
    }

    // True when `field` either stays the same or moves by exactly +1 / -1.
    // Null-safe: a missing value on either side is treated as 0, so the
    // first follower / first review still passes.
    function counterDeltaOk(field) {
      return (
        (field in resource.data ? resource.data[field] : 0)
          == (field in request.resource.data ? request.resource.data[field] : 0)
        || (field in request.resource.data ? request.resource.data[field] : 0)
          == (field in resource.data ? resource.data[field] : 0) + 1
        || (field in request.resource.data ? request.resource.data[field] : 0)
          == (field in resource.data ? resource.data[field] : 0) - 1
      );
    }

    function listingVisible() {
      return resource.data.status == 'approved'
        || (signedIn() && resource.data.ownerId == request.auth.uid)
        || isAdmin();
    }

    function listingDocVisible(listingId) {
      return get(/databases/$(database)/documents/listings/$(listingId)).data.status == 'approved'
        || (signedIn() && get(/databases/$(database)/documents/listings/$(listingId)).data.ownerId == request.auth.uid)
        || isAdmin();
    }

    // الستوريز محتوى عام للنشر — قراءتها مفتوحة للجميع.
    // فلترة الانتهاء (expiresAt) تتم في العميل لتفادي فشل الاستعلامات
    // التي يقيّمها Firestore على القاعدة بدون قراءة بيانات الوثيقة.
    // الكتابة والحذف لا يزالان محميَّيْن بصرامة أدناه.
    function storyVisible() {
      return true;
    }

    match /users/{userId} {
      allow read: if true;

      allow create: if isMe(userId)
        && request.resource.data.uid == request.auth.uid
        && (
          request.resource.data.isAdmin == false
          || (request.resource.data.isAdmin == true && isBootstrapAdminCreate())
        );

      allow update: if (
          isMe(userId)
          && unchanged(['uid', 'isAdmin', 'createdAt', 'isVerifiedDealer', 'verifiedAt'])
          && request.resource.data.keys().hasOnly([
            'uid',
            'name',
            'email',
            'phone',
            'photoURL',
            'coverURL',
            'businessName',
            'dealerName',
            'dealerLogo',
            'dealerCover',
            'dealerBio',
            'workingHours',
            'locationUrl',
            'isVerifiedDealer',
            'verifiedAt',
            'city',
            'bio',
            'whatsapp',
            'rating',
            'reviewsCount',
            'ratingsCount',
            'averageRating',
            'phoneVerified',
            'updatedAt',
            'lastLoginAt',
            'isAdmin',
            'createdAt',
            'followersCount',
            'followingCount',
            'listingsCount',
            'servicesCount',
            'isOnline',
            'lastSeenAt',
            'role'
          ])
        )
        || (
          // الأدمن يستطيع تعديل أي حقل في ملف أي مستخدم — بما في ذلك
          // حقول التوثيق (isVerifiedDealer, verifiedAt). هذا الفرع
          // الوحيد الذي يسمح بتغيير حالة التوثيق.
          isAdmin()
        )
        || (
          // A different signed-in user may ONLY nudge the follow counters
          // on this profile, and only by exactly +1 / -1 (or no-op).
          // Used by the follow / unfollow transaction.
          signedIn()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['followersCount', 'followingCount'])
          && counterDeltaOk('followersCount')
          && counterDeltaOk('followingCount')
        )
        || (
          // A different signed-in user may ONLY adjust this profile's
          // rating aggregates (averageRating + reviewsCount), nothing else.
          // We cannot read the sibling review-doc write from inside the same
          // transaction, so we constrain the *values* instead: averageRating
          // must be a valid 0..5 number and reviewsCount a non-negative int
          // that moves by at most 1. The trader page also derives these live
          // from the reviews subcollection, so a tampered value is cosmetic
          // and self-corrects on the next real review.
          signedIn()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['averageRating', 'reviewsCount'])
          && counterDeltaOk('reviewsCount')
          && request.resource.data.reviewsCount is int
          && request.resource.data.reviewsCount >= 0
          && request.resource.data.averageRating is number
          && request.resource.data.averageRating >= 0
          && request.resource.data.averageRating <= 5
        )
        || isAdmin();

      allow delete: if isAdmin();

      match /favorites/{listingId} {
        allow read: if isMe(userId) || isAdmin();
        allow create, update, delete: if isMe(userId);
      }

      match /following/{targetUserId} {
        allow read: if isMe(userId) || isAdmin();
        allow create, update, delete: if isMe(userId);
      }

      match /followers/{followerUserId} {
        allow read: if isMe(userId) || isAdmin();
        allow create, update, delete: if isMe(followerUserId) || isAdmin();
      }

      match /likedListings/{listingId} {
        allow read: if isMe(userId) || isAdmin();
        allow create, update, delete: if isMe(userId);
      }

      // تنبيهات سياراتي - تنبيهات البحث الخاصة بكل مستخدم.
      // المالك فقط يقرأ ويكتب تنبيهاته. لا يوجد فحص متبادل لتنبيهات
      // الآخرين — كل مستخدم يفحص بياناته الخاصة client-side عند فتح
      // التطبيق ويُنشئ الإشعار لنفسه.
      match /searchAlerts/{alertId} {
        allow read: if isMe(userId);
        allow create: if isMe(userId)
          && request.resource.data.userId == userId;
        allow update: if isMe(userId)
          && request.resource.data.userId == userId;
        allow delete: if isMe(userId);
      }

      // Trader reviews. Document id MUST equal the reviewer's uid, so each
      // user has at most one review per trader. A trader cannot review
      // itself. Rating is constrained to 1..5.
      match /reviews/{reviewId} {
        allow read: if true;

        allow create: if signedIn()
          && reviewId == request.auth.uid
          && request.auth.uid != userId
          && request.resource.data.reviewerId == request.auth.uid
          && request.resource.data.rating is number
          && request.resource.data.rating >= 1
          && request.resource.data.rating <= 5;

        allow update: if signedIn()
          && reviewId == request.auth.uid
          && request.auth.uid != userId
          && request.resource.data.reviewerId == request.auth.uid
          && request.resource.data.rating is number
          && request.resource.data.rating >= 1
          && request.resource.data.rating <= 5;

        allow delete: if (signedIn() && reviewId == request.auth.uid) || isAdmin();
      }
    }

    match /listings/{listingId} {
      allow read: if listingVisible();

      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.status == 'pending';

      allow update: if (
          signedIn()
          && resource.data.ownerId == request.auth.uid
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.status == resource.data.status
        )
        || (
          // Any signed-in user may ONLY adjust engagement counters.
          // Used by the like and comment transactions. Owner/status and
          // every other field must stay byte-for-byte unchanged.
          signedIn()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['likesCount', 'commentsCount'])
        )
        || isAdmin();

      allow delete: if (signedIn() && resource.data.ownerId == request.auth.uid) || isAdmin();

      match /comments/{commentId} {
        allow read: if listingDocVisible(listingId);
        allow create: if signedIn()
          && request.resource.data.userId == request.auth.uid;
        allow delete: if signedIn() && (
          resource.data.userId == request.auth.uid ||
          get(/databases/$(database)/documents/listings/$(listingId)).data.ownerId == request.auth.uid ||
          isAdmin()
        );
        // Reporting a comment: a signed-in user who is NOT the author may
        // only touch the report fields, and reportedCount may only go up.
        allow update: if (
          signedIn()
          && resource.data.userId != request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['reported', 'reportedCount', 'lastReportedAt'])
          && request.resource.data.reported == true
          && request.resource.data.reportedCount == resource.data.reportedCount + 1
        ) || isAdmin();
      }

      match /likes/{userId} {
        allow read: if listingDocVisible(listingId);
        allow create, delete: if isMe(userId);
        allow update: if false;
      }
    }

    match /stories/{storyId} {
      allow read: if storyVisible();

      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.type in ['car', 'service', 'offer']
        && request.resource.data.media is list
        && request.resource.data.media.size() > 0
        && request.resource.data.media.size() <= 10
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time;

      allow update: if (
          signedIn()
          && resource.data.ownerId == request.auth.uid
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.createdAt == resource.data.createdAt
        ) || isAdmin() || (
          signedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewsCount'])
          && request.resource.data.viewsCount == resource.data.viewsCount + 1
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.type == resource.data.type
          && request.resource.data.coverUrl == resource.data.coverUrl
        );

      allow delete: if (signedIn() && resource.data.ownerId == request.auth.uid) || isAdmin();

      match /viewers/{viewerId} {
        allow read: if signedIn() && (
          request.auth.uid == viewerId ||
          get(/databases/$(database)/documents/stories/$(storyId)).data.ownerId == request.auth.uid ||
          isAdmin()
        );

        allow create: if isMe(viewerId)
          && request.resource.data.userId == request.auth.uid;

        allow update, delete: if false;
      }
    }

    match /chats/{chatId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participants;
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.size() == 2;
      allow update: if signedIn() && request.auth.uid in resource.data.participants;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow create: if signedIn()
          && request.resource.data.senderId == request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        // التحديث مسموح فقط لحقل reactions، وفقط للمشتركين في المحادثة.
        // هذا يسمح بإضافة/إزالة قلب على رسالة، ولا يسمح بتعديل نصها أو
        // أي حقل آخر. نتحقق من ذلك عبر affectedKeys() ≤ {reactions}.
        allow update: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions']);
        allow delete: if false;
      }
    }

    match /notifications/{notificationId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn()
        && (
          !request.resource.data.keys().hasAny(['actorId'])
          || request.resource.data.actorId == request.auth.uid
        );
      allow update: if signedIn() && resource.data.userId == request.auth.uid;
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    // طلبات توثيق المعارض - يرسلها المستخدم من /dealer-verification.
    // المستخدم ينشئ طلبه فقط (مع userId == auth.uid + status بدء pending)،
    // ويقرأ طلباته فقط. الأدمن يقرأ كل الطلبات ويُحدّث/يحذف.
    match /dealerVerificationRequests/{requestId} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending';
      allow read: if signedIn() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow update, delete: if isAdmin();
    }

    // شعارات الماركات - public read، فقط الأدمن يكتب/يحذف.
    // وثيقة واحدة لكل brand id (مثل brandLogos/toyota).
    // البنية: { brandId: string, logoUrl: string, updatedAt }
    match /brandLogos/{brandId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
