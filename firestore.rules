rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isMe(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    function unchanged(keys) {
      return request.resource.data.diff(resource.data).unchangedKeys().hasAll(keys);
    }

    function listingVisible() {
      return resource.data.status == 'approved'
        || (signedIn() && resource.data.ownerId == request.auth.uid)
        || isAdmin();
    }

    function listingDocVisible(listingId) {
      return get(/databases/$(database)/documents/listings/$(listingId)).data.status == 'approved'
        || (signedIn() && get(/databases/$(database)/documents/listings/$(listingId)).data.ownerId == request.auth.uid)
        || isAdmin();
    }

    function storyVisible() {
      return (resource.data.expiresAt is timestamp && resource.data.expiresAt > request.time)
        || (signedIn() && resource.data.ownerId == request.auth.uid)
        || isAdmin();
    }

    match /users/{userId} {
      allow read: if true;

      allow create: if isMe(userId)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.isAdmin == false;

      allow update: if (
          isMe(userId)
          && unchanged(['uid', 'isAdmin', 'createdAt'])
          && request.resource.data.keys().hasOnly([
            'uid',
            'name',
            'email',
            'phone',
            'photoURL',
            'businessName',
            'city',
            'bio',
            'whatsapp',
            'rating',
            'reviewsCount',
            'phoneVerified',
            'updatedAt',
            'lastLoginAt',
            'isAdmin',
            'createdAt'
          ])
        ) || isAdmin();

      allow delete: if isAdmin();

      match /favorites/{listingId} {
        allow read: if isMe(userId) || isAdmin();
        allow create, update, delete: if isMe(userId);
      }

      match /following/{targetUserId} {
        allow read: if isMe(userId) || isAdmin();
        allow create, update, delete: if isMe(userId);
      }

      match /followers/{followerUserId} {
        allow read: if isMe(userId) || isAdmin();
        allow create, update, delete: if isMe(followerUserId) || isAdmin();
      }

      match /likedListings/{listingId} {
        allow read: if isMe(userId) || isAdmin();
        allow create, update, delete: if isMe(userId);
      }

      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
        allow update, delete: if isAdmin();
      }
    }

    match /listings/{listingId} {
      allow read: if listingVisible();

      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.status == 'pending';

      allow update: if (
          signedIn()
          && resource.data.ownerId == request.auth.uid
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.status == resource.data.status
        ) || isAdmin();

      allow delete: if (signedIn() && resource.data.ownerId == request.auth.uid) || isAdmin();

      match /comments/{commentId} {
        allow read: if listingDocVisible(listingId);
        allow create: if signedIn()
          && request.resource.data.userId == request.auth.uid;
        allow delete: if signedIn() && (
          resource.data.userId == request.auth.uid ||
          get(/databases/$(database)/documents/listings/$(listingId)).data.ownerId == request.auth.uid ||
          isAdmin()
        );
        allow update: if false;
      }

      match /likes/{userId} {
        allow read: if listingDocVisible(listingId);
        allow create, delete: if isMe(userId);
        allow update: if false;
      }
    }

    match /stories/{storyId} {
      allow read: if storyVisible();

      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.type in ['car', 'service', 'offer']
        && request.resource.data.media is list
        && request.resource.data.media.size() > 0
        && request.resource.data.media.size() <= 10
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time;

      allow update: if (
          signedIn()
          && resource.data.ownerId == request.auth.uid
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.createdAt == resource.data.createdAt
        ) || isAdmin() || (
          signedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewsCount'])
          && request.resource.data.viewsCount == resource.data.viewsCount + 1
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.type == resource.data.type
          && request.resource.data.coverUrl == resource.data.coverUrl
        );

      allow delete: if (signedIn() && resource.data.ownerId == request.auth.uid) || isAdmin();

      match /viewers/{viewerId} {
        allow read: if signedIn() && (
          request.auth.uid == viewerId ||
          get(/databases/$(database)/documents/stories/$(storyId)).data.ownerId == request.auth.uid ||
          isAdmin()
        );

        allow create: if isMe(viewerId)
          && request.resource.data.userId == request.auth.uid;

        allow update, delete: if false;
      }
    }

    match /chats/{chatId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participants;
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.size() == 2;
      allow update: if signedIn() && request.auth.uid in resource.data.participants;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow create: if signedIn()
          && request.resource.data.senderId == request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow update, delete: if false;
      }
    }

    match /notifications/{notificationId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn()
        && (
          !request.resource.data.keys().hasAny(['actorId'])
          || request.resource.data.actorId == request.auth.uid
        );
      allow update: if signedIn() && resource.data.userId == request.auth.uid;
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
